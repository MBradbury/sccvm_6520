# Module details - fill these in.
#
# This file is read by the scripts in tools/ (check.sh validates names against
# MODULE_CODE, rename.sh sets it) and by the Systems Ansible role that deploys
# this module, which takes the module details, target hosts and packages from here.
# Keep it as plain KEY="value" lines so it can be sourced by bash.
#
# MODULE_CODE must be lower case and match the module role name, e.g. scc_253 or sccm_5550.
# After changing it, rename every "sccm_6520" in this repo (see README step 2).

MODULE_CODE="sccm_6520"
MODULE_NAME="Secure Cyber Physical Systems"
CONVENOR="Matthew Bradbury"
CONVENOR_EMAIL="m.s.bradbury@lancaster.ac.uk"

# Teaching weeks and first teaching day (YYYY-MM-DD)
TERM="11-20"
START_DATE="2026-01-12"

# Where students need the VMs: "lab", "vdi" or "both"
DEPLOY_TO="both"

# Anything else Systems should know (networking between VMs, internet access, licences...).
NOTES=""
